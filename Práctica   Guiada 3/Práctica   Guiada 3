<html>
    <!-- La sección <head> contiene metadatos e información que no se muestra en el cuerpo de la página -->
    <head>
        <!-- Define el título que aparece en la pestaña del navegador -->
        <title>Página WEB de ejemplo: texto</title>
    </head>
    
    <!-- La sección <body> contiene todo el contenido visible de la página web -->
    <body>
        <!-- Texto plano seguido de <br/>, que inserta un salto de línea -->
        Esta es línea, y a continuación insertamos un salto de línea.<br/>
        
        <!-- Etiqueta <center> usada para centrar un bloque de texto -->
        <center>Esta es otra línea.</center>
        
        <!-- Otro texto plano con salto de línea -->
        Esta es una línea, y a continuación insertamos un salto de línea.<br/>
        
        <!-- Párrafo alineado a la izquierda mediante el atributo align="left" -->
        <p align="left">El texto de este párrafo está alineado a la izquierda (por defecto, si no se indi
        
        <!-- Párrafo alineado al centro mediante el atributo align="center" -->
        <p align="center">El texto de este párrafo está alineado al centro.</p>
        
        <!-- Párrafo alineado a la derecha mediante el atributo align="right" -->
        <p align="right";>El texto de este párrafo está alineado a la derecha.</p>
    </body>
</html>